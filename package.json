{
  "name": "@axiosleo/cli-tool",
  "version": "1.6.12",
  "description": "Design for quickly developing CLI applications using Node.js.",
  "keywords": [
    "cli",
    "tool",
    "nodejs",
    "develop",
    "kit",
    "command",
    "workflow",
    "locales",
    "debug"
  ],
  "author": "AxiosLeo",
  "types": "index.d.ts",
  "directories": {
    "lib": "src"
  },
  "bin": {
    "cli-tool": "./bin/cli-tool.js"
  },
  "scripts": {
    "lint": "tsc --noEmit --types node --skipDefaultLibCheck ./index.d.ts && eslint --fix src/ tests/",
    "test": "mocha --reporter spec --timeout 3000 tests/*.tests.js",
    "test-cov": "nyc -r=lcov -r=html -r=text -r=json mocha -t 10000 -R spec tests/*.tests.js",
    "test-one": "mocha --reporter spec --timeout 3000",
    "ci": "npm run lint && npm run test-cov",
    "clear": "rm -rf ./nyc_output ./coverage ./node_modules/ ./package-lock.json ./pnpm-lock.yaml"
  },
  "license": "MIT",
  "dependencies": {
    "big.js": "^7.0.1",
    "clone-deep": "^4.0.1",
    "enquirer": "^2.4.1",
    "minimist": "^1.2.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AxiosLeo/node-cli"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/big.js": "^7.0.0",
    "@types/node": "26.6.6",
    "chai": "6.3.0",
    "chai-as-promised": "8.0.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "mocha": "12.0.3",
    "nyc": "18.0.0",
    "sinon": "22.1.0",
    "typescript": "7.0.2"
  }
}
